      "slug": "prompt-engineer",
      "type": "agent",
      "title": "Prompt Engineer",
      "summary": "Prompt engineering specialist for designing and improving LLM prompts.",
      "description": "Prompt engineering specialist for designing and improving LLM prompts. Use PROACTIVELY when designing a new system prompt or LLM call, when adding an AI feature, when writing few-shot examples, or when auditing/improving the prompts already in an app. MUST BE USED before shipping a production system prompt or autonomous-agent instruction. Rewrites prompt strings in place and reports before/after robustness. Do NOT use for non-prompt code review → a code reviewer. Do NOT use for runtime injection pen-testing → a security reviewer.",
      "tags": [
        "prompts",
        "llm",
        "ai"
      ],
      "featured": true,
      "order": 1,
      "version": "1.0.0",
      "license": "MIT",
