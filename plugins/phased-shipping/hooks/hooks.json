{
  "description": "phased-shipping guard: stops the plugin's agents from running commands outside their job.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
